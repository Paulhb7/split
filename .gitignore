# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/

# The Python backend is no longer the default — Rust took over (see
# `core-rs/` + `apps/desktop/src-tauri/src/runner.rs`). The folder is kept
# locally for transition / reference / "ne pas perdre de vue", but the
# repo no longer tracks it. Fresh clones don't get Python; the desktop app
# defaults to the native Rust runner. To re-enable Python locally: keep
# `split-python/` checked-out and set `localStorage.setItem("split.runner",
# "python")` in DevTools.
split-python/

# secrets
.env

# generated state · vendored harness binaries · retired code (all under var/)
var/

# parked / unused files moved out of the live tree (audit cleanup)
archive/

# desktop build artifacts
apps/desktop/node_modules/
apps/desktop/dist/

# Rust build artifacts — the Cargo workspace shares a single root `target/`
# (one cache across `apps/desktop/src-tauri` + `core-rs`). The nested
# `apps/desktop/src-tauri/target/` is the legacy non-workspace location and
# is kept here so pre-workspace clones don't accidentally check it in.
target/
apps/desktop/src-tauri/target/

Claude.md

